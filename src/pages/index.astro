---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---
<Layout title="Solomzi — Network Engineer">
  <div class="wrap">
    <section class="hero">
      <span class="eyebrow">show running-config | networking &amp; security</span>
      <h1 aria-label="I build, break, and document networks.">
  <span id="hero-type" aria-hidden="true">I build, break, and document networks.</span><span class="caret" aria-hidden="true"></span>
</h1>
      <p>
        Network engineer working toward CCNP, with hands-on lab work across
        Cisco, Fortinet, and Aruba gear — routing, switching, firewalls, and
        automating all of it with Ansible. This site is my lab notebook.
      </p>
      <div class="hero-links">
        <a class="btn primary" href="/blog">Read the lab notes</a>
        <a class="btn" href="/about">About me</a>
      </div>
    </section>

    <section class="section">
      <div class="section-label">// core skills</div>
      <div class="skills-grid">
        <div class="skill-card">
          <div class="name">Routing &amp; Switching</div>
          <div class="detail">OSPF · BGP · MPLS · VRF · VLANs</div>
        </div>
        <div class="skill-card">
          <div class="name">Network Security</div>
          <div class="detail">Fortinet · Cisco ASA · DMZ · WAF · AAA</div>
        </div>
        <div class="skill-card">
          <div class="name">Automation</div>
          <div class="detail">Ansible · scripted VLAN &amp; routing configs</div>
        </div>
        <div class="skill-card">
          <div class="name">Platforms</div>
          <div class="detail">Cisco IOS · Fortinet · Aruba · VyOS</div>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="section-label">// recent lab notes</div>
      <table class="route-table">
        <thead>
          <tr>
            <th>Destination</th>
            <th>Flags</th>
            <th>Metric</th>
          </tr>
        </thead>
        <tbody>
          {posts.map((post) => (
            <tr class="route-row">
              <td class="route-dest">
                <a href={`/blog/${post.slug}/`}>{post.data.title}</a>
                <div class="route-summary">{post.data.summary}</div>
              </td>
              <td>
                {post.data.tags.map((tag) => <span class="route-flag">{tag}</span>)}
              </td>
              <td class="route-meta">
                {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}<br/>
                {post.data.readTime}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>
  </div>
</Layout>

<script>
  const el = document.getElementById('hero-type');
  if (el && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const fullText = el.textContent.trim();
    el.textContent = '';
    let i = 0;
    function type() {
      if (i < fullText.length) {
        el.textContent += fullText[i];
        i++;
        setTimeout(type, 45);
      }
    }
    type();
  }
</script>