---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allPosts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const posts = allPosts.slice(0, 3);
const postCount = allPosts.length;
const yearsInField = new Date().getFullYear() - 2019;
---
<Layout title="Solomzi — Network Engineer &amp; IT Systems Specialist">
  <div class="wrap">
    <section class="hero">
      <span class="eyebrow">show running-config | networking, cloud &amp; IT support</span>
      <h1 aria-label="I build, break, and document networks.">
        <span class="type-target" aria-hidden="true">I build, break, and document networks.</span><span class="caret" aria-hidden="true"></span>
      </h1>
      <p>
        IT Support Technician, Systems Administrator, and Network Engineer
        working toward CCNP — Windows/Linux/macOS support, Active Directory
        and Microsoft 365, plus routing, firewalls, and cloud infrastructure.
        This site is my lab notebook.
      </p>
      <div class="hero-links">
        <a class="btn primary" href="/blog">Read the lab notes</a>
        <a class="btn" href="/about">About me</a>
      </div>
    </section>
    <section class="section" style="border-top: none;">
  <div class="neofetch">
    <div class="neofetch-icon" aria-hidden="true">
      <svg width="72" height="72" viewBox="0 0 160 160" xmlns="http://www.w3.org/2000/svg">
        <rect x="4" y="4" width="152" height="152" rx="24" fill="#1c2733" stroke="#2e3d4d" stroke-width="2" />
        <text x="80" y="98" font-family="monospace" font-size="52" font-weight="600" fill="#e8a33d" text-anchor="middle">&gt;_</text>
      </svg>
    </div>
    <div class="neofetch-info">
      <div class="neofetch-header">solomzi@edge</div>
      <div class="neofetch-rule">-----------------</div>
      <div class="neofetch-line"><span class="neofetch-key">OS</span>: IT Support · SysAdmin · NetEng</div>
      <div class="neofetch-line"><span class="neofetch-key">Host</span>: ByteHub Solutions</div>
      <div class="neofetch-line"><span class="neofetch-key">Kernel</span>: CCNP, AZ-104 (in progress)</div>
      <div class="neofetch-line"><span class="neofetch-key">Uptime</span>: {yearsInField}+ years in IT</div>
      <div class="neofetch-line"><span class="neofetch-key">Certs</span>: CCNA, CC, Google Cybersecurity</div>
      <div class="neofetch-line"><span class="neofetch-key">Packages</span>: {postCount} (lab notes)</div>
      <div class="neofetch-line"><span class="neofetch-key">Shell</span>: bash / PowerShell / Python</div>
      <div class="neofetch-swatches" aria-hidden="true">
        <span style="background:#0f1720;"></span>
        <span style="background:#1c2733;"></span>
        <span style="background:#2e3d4d;"></span>
        <span style="background:#7d8b98;"></span>
        <span style="background:#c8d0d8;"></span>
        <span style="background:#e8a33d;"></span>
        <span style="background:#5fb3a3;"></span>
        <span style="background:#f2f5f7;"></span>
      </div>
    </div>
  </div>
</section>

<style>
  .neofetch {
    display: flex;
    gap: 24px;
    align-items: flex-start;
    flex-wrap: wrap;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px 24px;
  }
  .neofetch-icon {
    flex-shrink: 0;
  }
  .neofetch-info {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    line-height: 1.7;
    color: var(--text);
  }
  .neofetch-header {
    color: var(--amber);
    font-weight: 600;
  }
  .neofetch-rule {
    color: var(--text-dim);
  }
  .neofetch-key {
    color: var(--teal);
    font-weight: 600;
  }
  .neofetch-swatches {
    display: flex;
    gap: 4px;
    margin-top: 8px;
  }
  .neofetch-swatches span {
    width: 16px;
    height: 16px;
    border-radius: 2px;
  }
</style>

    <section class="section">
      <div class="section-label">// core skills</div>
      <div class="skills-grid">
        <div class="skill-card">
          <div class="name">IT Support &amp; Systems</div>
          <div class="detail">Active Directory · Microsoft 365 · Windows/Linux/macOS</div>
        </div>
        <div class="skill-card">
          <div class="name">Routing &amp; Switching</div>
          <div class="detail">OSPF · BGP · MPLS · VRF · VLANs</div>
        </div>
        <div class="skill-card">
          <div class="name">Network Security</div>
          <div class="detail">Palo Alto · Fortinet · Cisco ASA · IDS/IPS</div>
        </div>
        <div class="skill-card">
          <div class="name">Cloud</div>
          <div class="detail">Azure · AWS · GCP</div>
        </div>
        <div class="skill-card">
          <div class="name">Automation</div>
          <div class="detail">Ansible · Python · Terraform (learning)</div>
        </div>
      </div>
    </section>

    <section class="section" id="home-lab">
      <div class="section-label">// home lab</div>
      <svg viewBox="0 0 680 420" xmlns="http://www.w3.org/2000/svg" width="100%" role="img" style="max-width: 640px;">
        <title>Home lab network topology</title>
        <desc>Internet connects to a firewall, which connects to a core switch, which distributes to three VLANs: Management, Servers and Lab, and Guest and IoT.</desc>
        <defs>
          <marker id="topo-arrow-home" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
            <path d="M2 1L8 5L2 9" fill="none" stroke="#5fb3a3" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </marker>
        </defs>
        <text x="340" y="24" text-anchor="middle" font-family="monospace" font-size="12" fill="#7d8b98">home lab topology</text>
        <circle cx="340" cy="55" r="18" fill="none" stroke="#2e3d4d" stroke-width="1.5" />
        <text x="340" y="59" text-anchor="middle" font-family="monospace" font-size="11" fill="#c8d0d8">WAN</text>
        <line x1="340" y1="73" x2="340" y2="100" stroke="#5fb3a3" stroke-width="1.5" marker-end="url(#topo-arrow-home)" />
        <rect x="260" y="100" width="160" height="46" rx="6" fill="#1c2733" stroke="#e8a33d" stroke-width="1.5" />
        <text x="340" y="119" text-anchor="middle" font-family="monospace" font-size="13" fill="#f2f5f7" font-weight="600">Firewall</text>
        <text x="340" y="135" text-anchor="middle" font-family="monospace" font-size="10" fill="#7d8b98">Fortinet / pfSense</text>
        <line x1="340" y1="146" x2="340" y2="173" stroke="#5fb3a3" stroke-width="1.5" marker-end="url(#topo-arrow-home)" />
        <rect x="250" y="173" width="180" height="46" rx="6" fill="#1c2733" stroke="#2e3d4d" stroke-width="1.5" />
        <text x="340" y="192" text-anchor="middle" font-family="monospace" font-size="13" fill="#f2f5f7" font-weight="600">Core switch</text>
        <text x="340" y="208" text-anchor="middle" font-family="monospace" font-size="10" fill="#7d8b98">802.1Q trunk</text>
        <line x1="340" y1="219" x2="130" y2="255" stroke="#2e3d4d" stroke-width="1.5" marker-end="url(#topo-arrow-home)" />
        <line x1="340" y1="219" x2="340" y2="255" stroke="#2e3d4d" stroke-width="1.5" marker-end="url(#topo-arrow-home)" />
        <line x1="340" y1="219" x2="550" y2="255" stroke="#2e3d4d" stroke-width="1.5" marker-end="url(#topo-arrow-home)" />
        <rect x="40" y="255" width="180" height="140" rx="8" fill="none" stroke="#2e3d4d" stroke-width="1" stroke-dasharray="4 3" />
        <text x="130" y="275" text-anchor="middle" font-family="monospace" font-size="11" fill="#5fb3a3" font-weight="600">VLAN 10 · Management</text>
        <rect x="60" y="290" width="140" height="34" rx="4" fill="#1c2733" stroke="#2e3d4d" stroke-width="1" />
        <text x="130" y="311" text-anchor="middle" font-family="monospace" font-size="11" fill="#c8d0d8">Switch mgmt / AP</text>
        <rect x="60" y="334" width="140" height="34" rx="4" fill="#1c2733" stroke="#2e3d4d" stroke-width="1" />
        <text x="130" y="355" text-anchor="middle" font-family="monospace" font-size="11" fill="#c8d0d8">Jump host</text>
        <rect x="250" y="255" width="180" height="140" rx="8" fill="none" stroke="#2e3d4d" stroke-width="1" stroke-dasharray="4 3" />
        <text x="340" y="275" text-anchor="middle" font-family="monospace" font-size="11" fill="#5fb3a3" font-weight="600">VLAN 20 · Servers &amp; lab</text>
        <rect x="270" y="290" width="140" height="34" rx="4" fill="#1c2733" stroke="#2e3d4d" stroke-width="1" />
        <text x="340" y="311" text-anchor="middle" font-family="monospace" font-size="11" fill="#c8d0d8">ESXi / Proxmox host</text>
        <rect x="270" y="334" width="140" height="34" rx="4" fill="#1c2733" stroke="#2e3d4d" stroke-width="1" />
        <text x="340" y="355" text-anchor="middle" font-family="monospace" font-size="11" fill="#c8d0d8">GNS3 / Docker labs</text>
        <rect x="460" y="255" width="180" height="140" rx="8" fill="none" stroke="#2e3d4d" stroke-width="1" stroke-dasharray="4 3" />
        <text x="550" y="275" text-anchor="middle" font-family="monospace" font-size="11" fill="#5fb3a3" font-weight="600">VLAN 30 · Guest &amp; IoT</text>
        <rect x="480" y="290" width="140" height="34" rx="4" fill="#1c2733" stroke="#2e3d4d" stroke-width="1" />
        <text x="550" y="311" text-anchor="middle" font-family="monospace" font-size="11" fill="#c8d0d8">CCTV / NVR</text>
        <rect x="480" y="334" width="140" height="34" rx="4" fill="#1c2733" stroke="#2e3d4d" stroke-width="1" />
        <text x="550" y="355" text-anchor="middle" font-family="monospace" font-size="11" fill="#c8d0d8">Guest Wi-Fi</text>
      </svg>
      <p style="margin-top: 16px;"><a href="/about#home-lab-projects">See the projects built on this lab &rarr;</a></p>
    </section>

    <section class="section">
      <div class="section-label">// recent lab notes</div>
      <table class="route-table">
        <thead>
          <tr>
            <th>Destination</th>
            <th>Flags</th>
            <th>Metric</th>
          </tr>
        </thead>
        <tbody>
          {posts.map((post) => (
            <tr class="route-row">
              <td class="route-dest">
                <a href={`/blog/${post.slug}/`}>{post.data.title}</a>
                <div class="route-summary">{post.data.summary}</div>
              </td>
              <td>
                  {post.data.tags.map((tag) => <a class="route-flag" href={`/blog/tags/${tag}/`}>{tag}</a>)}
              </td>
              <td class="route-meta">
                {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}<br/>
                {post.data.readTime}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>
  </div>
</Layout>
