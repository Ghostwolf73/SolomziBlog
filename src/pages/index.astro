---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---
<Layout title="Solomzi — Network Engineer &amp; IT Systems Specialist">
  <div class="wrap">
    <section class="hero">
      <span class="eyebrow">show running-config | networking, cloud &amp; IT support</span>
      <h1 aria-label="I build, break, and document networks.">
        <span class="type-target" aria-hidden="true">I build, break, and document networks.</span><span class="caret" aria-hidden="true"></span>
      </h1>
      <p>
        IT Support Technician, Systems Administrator, and Network Engineer
        working toward CCNP — Windows/Linux/macOS support, Active Directory
        and Microsoft 365, plus routing, firewalls, and cloud infrastructure.
        This site is my lab notebook.
      </p>
      <div class="hero-links">
        <a class="btn primary" href="/blog">Read the lab notes</a>
        <a class="btn" href="/about">About me</a>
      </div>
    </section>

    <section class="section">
      <div class="section-label">// core skills</div>
      <div class="skills-grid">
        <div class="skill-card">
          <div class="name">IT Support &amp; Systems</div>
          <div class="detail">Active Directory · Microsoft 365 · Windows/Linux/macOS</div>
        </div>
        <div class="skill-card">
          <div class="name">Routing &amp; Switching</div>
          <div class="detail">OSPF · BGP · MPLS · VRF · VLANs</div>
        </div>
        <div class="skill-card">
          <div class="name">Network Security</div>
          <div class="detail">Palo Alto · Fortinet · Cisco ASA · IDS/IPS</div>
        </div>
        <div class="skill-card">
          <div class="name">Cloud</div>
          <div class="detail">Azure · AWS · GCP</div>
        </div>
        <div class="skill-card">
          <div class="name">Automation</div>
          <div class="detail">Ansible · Python · Terraform (learning)</div>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="section-label">// recent lab notes</div>
      <table class="route-table">
        <thead>
          <tr>
            <th>Destination</th>
            <th>Flags</th>
            <th>Metric</th>
          </tr>
        </thead>
        <tbody>
          {posts.map((post) => (
            <tr class="route-row">
              <td class="route-dest">
                <a href={`/blog/${post.slug}/`}>{post.data.title}</a>
                <div class="route-summary">{post.data.summary}</div>
              </td>
              <td>
                {post.data.tags.map((tag) => <span class="route-flag">{tag}</span>)}
              </td>
              <td class="route-meta">
                {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}<br/>
                {post.data.readTime}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>
  </div>
</Layout>