---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Contact — Solomzi" description="Get in touch with Solomzi Gumbo.">
  <div class="wrap">
    <section class="hero" style="padding-bottom: 24px;">
      <span class="eyebrow">open a connection</span>
      <h1 aria-label="Contact">
        <span class="type-target" aria-hidden="true">Contact</span><span class="caret" aria-hidden="true"></span>
      </h1>
      <p>
        Best way to reach me is email, WhatsApp or the form below, I check all
        regularly.
      </p>
      <div class="icon-links">
        <a href="mailto:solomzigumbo@gmail.com" class="icon-btn" aria-label="Email">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="5" width="18" height="14" rx="2" />
            <polyline points="3 7 12 13 21 7" />
          </svg>
          <span>email</span>
        </a>
        <a href="https://github.com/Ghostwolf73" class="icon-btn" aria-label="GitHub" target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="16 18 22 12 16 6" />
            <polyline points="8 6 2 12 8 18" />
          </svg>
          <span>github</span>
        </a>
        <a href="https://wa.me/263778198093" class="icon-btn" aria-label="WhatsApp" target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
          </svg>
          <span>whatsapp</span>
        </a>
      </div>
    </section>

    <section class="section" style="border-top: none;">
      <form
        name="contact"
        method="POST"
        data-netlify="true"
        netlify-honeypot="bot-field"
        action="/thanks/"
        style="max-width: 480px; display: flex; flex-direction: column; gap: 12px;"
      >
        <input type="hidden" name="form-name" value="contact" />
        <p style="display:none;">
          <label>Don't fill this out: <input name="bot-field" /></label>
        </p>
        <label style="font-family: var(--font-mono); font-size: 0.85rem; color: var(--text-dim);">
          Name
          <input type="text" name="name" required style="width:100%; margin-top:4px; padding:8px 10px; background:var(--surface); border:1px solid var(--border); border-radius:3px; color:var(--text); font-family:var(--font-mono);" />
        </label>
        <label style="font-family: var(--font-mono); font-size: 0.85rem; color: var(--text-dim);">
          Email
          <input type="email" name="email" required style="width:100%; margin-top:4px; padding:8px 10px; background:var(--surface); border:1px solid var(--border); border-radius:3px; color:var(--text); font-family:var(--font-mono);" />
        </label>
        <label style="font-family: var(--font-mono); font-size: 0.85rem; color: var(--text-dim);">
          Message
          <textarea name="message" rows="4" required style="width:100%; margin-top:4px; padding:8px 10px; background:var(--surface); border:1px solid var(--border); border-radius:3px; color:var(--text); font-family:var(--font-mono); resize:vertical;"></textarea>
        </label>
        <button type="submit" class="btn primary" style="align-self:flex-start; cursor:pointer;">Send</button>
      </form>
    </section>
  </div>
</Layout>

<style>
  .icon-links {
    display: flex;
    gap: 16px;
    margin-top: 20px;
  }
  .icon-btn {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    width: 76px;
    padding: 14px 8px;
    border: 1px solid var(--border);
    border-radius: 8px;
    color: var(--text-dim);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-decoration: none;
    transition: transform 0.18s ease, border-color 0.18s ease, color 0.18s ease, background 0.18s ease;
  }
  .icon-btn:hover {
    transform: translateY(-4px);
    border-color: var(--amber);
    color: var(--amber);
    background: var(--surface);
    text-decoration: none;
  }
  .icon-btn svg {
    transition: transform 0.18s ease;
  }
  .icon-btn:hover svg {
    transform: scale(1.1);
  }
  @media (prefers-reduced-motion: reduce) {
    .icon-btn,
    .icon-btn svg {
      transition: none;
    }
    .icon-btn:hover {
      transform: none;
    }
    .icon-btn:hover svg {
      transform: none;
    }
  }
</style>