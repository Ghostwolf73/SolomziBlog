---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---
<Layout title="Blog — Solomzi" description="Lab notes on routing, switching, security, and automation.">
  <div class="wrap">
    <section class="hero" style="padding-bottom: 24px;">
      <span class="eyebrow">show ip route</span>
      <h1 aria-label="Lab notes">
  <span class="type-target" aria-hidden="true">Lab notes</span><span class="caret" aria-hidden="true"></span>
</h1>
      <p>Write-ups from the homelab: routing, switching, firewalls, and automation, as I build toward CCNP.</p>
    </section>

    <section class="section" style="border-top: none;">
      <table class="route-table">
        <caption>Codes: LAB - homelab build, SEC - security, AUTO - automation, CERT - certification prep</caption>
        <thead>
          <tr>
            <th>Destination</th>
            <th>Flags</th>
            <th>Metric</th>
          </tr>
        </thead>
        <tbody>
          {posts.map((post) => (
            <tr class="route-row">
              <td class="route-dest">
                <a href={`/blog/${post.slug}/`}>{post.data.title}</a>
                <div class="route-summary">{post.data.summary}</div>
              </td>
              <td>
                {post.data.tags.map((tag) => <span class="route-flag">{tag}</span>)}
              </td>
              <td class="route-meta">
                {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}<br/>
                {post.data.readTime}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>
  </div>
</Layout>
