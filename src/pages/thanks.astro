---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Message sent — Solomzi" description="Thanks for reaching out.">
  <div class="wrap">
    <section class="hero">
      <span class="eyebrow">200 OK</span>
      <h1 aria-label="Message sent.">
        <span class="type-target" aria-hidden="true">Message sent.</span><span class="caret" aria-hidden="true"></span>
      </h1>
      <p>Thanks for reaching out — I'll get back to you soon.</p>
      <div class="hero-links">
        <a class="btn primary" href="/">Back home</a>
      </div>
    </section>
  </div>
</Layout>