---
import Layout from '../layouts/Layout.astro';
---
<Layout title="About — Solomzi">
  <div class="wrap">
    <section class="hero" style="padding-bottom: 24px;">
      <span class="eyebrow">whoami</span>
      <h1 aria-label="About me">
  <span class="type-target" aria-hidden="true">About me</span><span class="caret" aria-hidden="true"></span>
</h1>
      <p>
        I'm a network engineer working through my CCNP, with a homelab habit
        that's gotten a little out of hand — Cisco, Fortinet, and Aruba gear,
        Ansible playbooks, and a lot of packet captures. This site is where I
        write up the labs so future-me (and anyone else) can retrace the steps.
      </p>
      <p>
        Replace this paragraph with your own background: how you got into
        networking, what you're studying toward, and what kind of role you're
        looking for.
      </p>
    </section>

    <section class="section">
      <div class="section-label">// experience</div>
      <p style="color: var(--text-dim);">
        ByteHubSolutions: Network and IT technician
      </p>
    </section>

    <section class="section">
      <div class="section-label">// certifications</div>
      <div class="skills-grid">
        <div class="skill-card">
          <div class="name">CCNA</div>
          <div class="detail">Add year / status</div>
        </div>
        <div class="skill-card">
          <div class="name">CCNP</div>
          <div class="detail">In progress</div>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="section-label">// contact</div>
      <p>
        <a href="mailto:solomzigumbo@gmail.com">Email</a> ·
        <a href="https://github.com/Ghostwolf73">GitHub</a> ·
        <a href="https://www.linkedin.com/in/solomzi-g-aa69b6206/">LinkedIn</a>
      </p>
    </section>
  </div>
</Layout>
